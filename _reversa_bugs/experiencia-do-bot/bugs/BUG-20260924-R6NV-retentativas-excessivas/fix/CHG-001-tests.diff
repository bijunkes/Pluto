diff --git a/tests/test_ia_failover.py b/tests/test_ia_failover.py
new file mode 100644
--- /dev/null
+++ b/tests/test_ia_failover.py
@@
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from src.services.exceptions import AnaliseIAError
+from src.services.gemini_service import GeminiService
+from src.services.ia_service import IAService
+
+
+def _resultado():
+    return {"produto": "Pão", "categoria": "Outros", "valor": 10.0}
+
+
+def test_503_faz_tres_chamadas_totais_antes_do_fallback(monkeypatch):
+    gemini = GeminiService.__new__(GeminiService)
+    generate_content = Mock(side_effect=Exception("503 UNAVAILABLE"))
+    gemini.client = SimpleNamespace(
+        models=SimpleNamespace(generate_content=generate_content)
+    )
+    gemini.categorias = ["Outros"]
+    groq = Mock()
+    groq.analisar_mensagem.return_value = _resultado()
+    service = IAService.__new__(IAService)
+    service.gemini = gemini
+    service.groq = groq
+    monkeypatch.setattr("src.services.gemini_service.time.sleep", Mock())
+    monkeypatch.setattr("src.services.ia_service.time.sleep", Mock())
+
+    assert service.analisar_mensagem("Comprei pão por R$ 10") == _resultado()
+
+    assert generate_content.call_count == 3
+    groq.analisar_mensagem.assert_called_once_with(
+        mensagem="Comprei pão por R$ 10"
+    )
+
+
+def test_erro_permanente_aciona_fallback_sem_repeticao(monkeypatch):
+    gemini = Mock()
+    gemini.analisar_mensagem.side_effect = AnaliseIAError("400 API_KEY_INVALID")
+    groq = Mock()
+    groq.analisar_mensagem.return_value = _resultado()
+    service = IAService.__new__(IAService)
+    service.gemini = gemini
+    service.groq = groq
+
+    assert service.analisar_mensagem("Compra") == _resultado()
+
+    gemini.analisar_mensagem.assert_called_once_with(
+        mensagem="Compra", imagem_path=None
+    )
+    groq.analisar_mensagem.assert_called_once_with(mensagem="Compra")
+
+
+def test_sucesso_do_gemini_nao_chama_groq():
+    gemini = Mock()
+    gemini.analisar_mensagem.return_value = _resultado()
+    groq = Mock()
+    service = IAService.__new__(IAService)
+    service.gemini = gemini
+    service.groq = groq
+
+    assert service.analisar_mensagem("Compra") == _resultado()
+
+    gemini.analisar_mensagem.assert_called_once_with(
+        mensagem="Compra", imagem_path=None
+    )
+    groq.analisar_mensagem.assert_not_called()
